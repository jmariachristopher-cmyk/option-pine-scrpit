# Copy this file to .streamlit/secrets.toml LOCALLY (never commit the real one).
# On Streamlit Community Cloud: App settings -> Secrets -> paste the same keys/values.

UPSTOX_CLIENT_ID = "your_upstox_client_id"
UPSTOX_CLIENT_SECRET = "your_upstox_client_secret"
UPSTOX_REDIRECT_URI = "https://localhost"
